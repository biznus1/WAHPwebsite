# Canonical site URL (used for metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://www.westahp.com

# Search indexing. Leave unset/false until the owner approves public launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional override of the public contact email (otherwise taken from the claims register)
# NEXT_PUBLIC_CONTACT_EMAIL=info@westahp.com

# --- Enquiry delivery (choose one). Without either, the form reports "not sent". ---

# Option A: email via Resend (https://resend.com)
# RESEND_API_KEY=
# ENQUIRY_FROM_EMAIL="WAHP Website <website@westahp.com>"   # must be a verified sender domain
# ENQUIRY_TO_EMAIL=info@westahp.com
# Optional per-type routing (comma-separated lists allowed):
# ENQUIRY_TO_EMAIL_INVESTOR=
# ENQUIRY_TO_EMAIL_PHYSICIAN=
# ENQUIRY_TO_EMAIL_PARTNERSHIP=
# ENQUIRY_TO_EMAIL_MEDIA=
# ENQUIRY_TO_EMAIL_GENERAL=

# Option B: JSON webhook (Zapier → Google Sheets, HubSpot, CRM, etc.)
# ENQUIRY_WEBHOOK_URL=
# ENQUIRY_WEBHOOK_SECRET=   # sent as X-WAHP-Secret header

# --- Site admin (Keystatic, /keystatic). See docs/ADMIN.md. ---
# Without these the admin works only under `npm run dev` and is switched off on a deployed site.
# NEXT_PUBLIC_KEYSTATIC_STORAGE=github
# NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=biznus1/WAHPwebsite
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
